[flake8]
# black formats to 88 columns; long strings and comments may run a little over.
max-line-length = 100
# E203/W503 conflict with black's slice and operator style.
extend-ignore = E203, W503
per-file-ignores =
    # these files adjust sys.path before importing the package
    tests/*: E402
    scripts/*: E402
    run.py: E402
# The dashboard code is left as it is.
exclude = .git, __pycache__, outputs, docs, .pytest_cache,
    src/jev_vllm/dashboard.py, scripts/build_dashboard.py, scripts/build_run_dashboard.py,
    scripts/dashboard, tests/test_build_run_dashboard.py, tests/test_dashboard_launch.py
