# Project configuration with # line comments. Trailing commas are not supported.
{
  # Filesystem paths. Relative paths resolve against this configuration directory.
  "paths": {
    # Local model directory containing weights, tokenizer, and model configuration.
    "model": "G:\\Qwen\\Qwen3-0.6B",

    # JSONL task file. Each line is one task with a unique id and a prompt.
    "dataset": "data/tasks.jsonl",

    # Directory for per-experiment records and generated answers.
    "outputs": "outputs"

  },

  # Arguments forwarded to the native vllm.LLM constructor.
  "engine": {
    # Computation precision; independent of sampling controls.
    "dtype": "bfloat16",

    # Combined prompt and completion context budget.
    "max_model_len": 40960,

    # Maximum sequences scheduled concurrently.
    "max_num_seqs": 1,

    # Fraction of GPU memory reserved for this engine.
    "gpu_memory_utilization": 0.5,

    # Disable compilation and CUDA graphs for the initial baseline.
    "enforce_eager": true,

    # Number of GPUs used for tensor parallelism.
    "tensor_parallel_size": 1
  },

  "runtime": {
    # Optional JIT sampling acceleration; keep off until batch 11 passes.
    "use_flashinfer_sampler": false
  },

  # TypeSafe evaluation endpoint, authentication source, and Score rubrics.
  "jev": {
    # HTTPS base URL for the external evaluation service.
    "base_url": "https://api.typesafe.ai",

    # Evaluation API route appended to the base URL.
    "endpoint": "/v1/systemone",

    # Evaluator model identifier sent to TypeSafe.
    "model": "jev-latest",

    # TypeSafe API key read directly by the client; redacted from experiment records.
    "api_key": "",

    # Timeout in seconds for each evaluation request; no automatic retry.
    "timeout_seconds": 90,

    # Rubric file path, resolved relative to this configuration file.
    "questions_file": "jev_questions.json",

    # How much generated text the Choice requests (direction/value) carry. The newest
    # keep_full segments are sent whole; older segments keep head+tail characters.
    "view": {
      "keep_full": 3,
      "head": 120,
      "tail": 200,

      # Apply the same shortening to Score requests. Off: Score input is unchanged.
      "score": false
    }

  },

  # Generation schedule and limits for one task, seed, and mode.
  "generation": {
    # Pass this boolean to the Qwen chat template before generation.
    "enable_thinking": true,

    # Maximum newly generated tokens per segment before evaluation.
    "chunk_tokens": 256,

    # Total new-token budget across all segments, including reasoning.
    "total_tokens": 8192,

    # Maximum generation/evaluation rounds per experiment.
    "max_rounds": 32

  },

  # Selected parameters, initial values, and type-specific Choice controls.
  "parameters_file": "parameters.json",

  # Experimental mode, random seeds, and evaluator call budget.
  "experiment": {
    # adaptive adjusts parameters; fixed keeps them; stop_only keeps them but may stop early; baseline calls no Jev.
    "mode": "adaptive",

    # Initial seeds. Each segment uses its initial seed plus the segment index.
    "seeds": [
      42 # Experiment seed 1.
    ],

    # Maximum evaluation requests per task, seed, and mode; not a global cap.
    "max_jev_calls": 96

  },

  # Controller settings. Stopping and rollback use normalized Score values.
  "policy": {

    # Optional early stopping. All three normalized-score thresholds must be met.
    # Applies to adaptive and stop_only; compare turns it off. When it fires inside the
    # thinking block, the runner closes the block and generates the final answer.
    "stopping": {
      "enabled": false,

      # Required normalized completeness score (0-1).
      "completeness_min": 0.9,

      # Required normalized correctness score (0-1).
      "correctness_min": 0.85,

      # Required normalized relevance score (0-1).
      "relevance_min": 0.75,

      # Token cap for the closing answer generated after an early stop.
      "final_answer_tokens": 256
    },

    # Restore the best-so-far parameters after consecutive utility declines.
    # No magnitude threshold: only the direction of change between rounds counts.
    "revert": {
      "enabled": true,

      # consecutive_decrease: k rounds in a row each lower than the previous one.
      # below_best: k rounds in a row lower than the best utility so far (more sensitive).
      "rule": "consecutive_decrease",

      # k.
      "consecutive_declines": 3
    },

    # Ratchet guard: after this many same-direction moves of one parameter, that direction
    # is no longer offered until the parameter moves the other way. 0 disables the guard.
    "limits": {
      "max_same_direction": 3
    },

    # A parameter answered keep this many rounds in a row is not asked for skip_rounds rounds.
    # 0 disables dormancy.
    "dormancy": {
      "keep_streak": 3,
      "skip_rounds": 5
    },

    # Nonnegative importance weights (0-1); at least one must be positive.
    # Code normalizes the weights and reverses repetition to produce a 0-1 quality score.
    "utility_weights": {
      # Utility weight for correctness. Positive to reward this dimension.
      "correctness": 0.45,

      # Utility weight for relevance. Positive to reward this dimension.
      "relevance": 0.3,

      # Utility weight for completeness. Positive to reward this dimension.
      "completeness": 0.15,

      # Positive importance of avoiding repetition; code handles the penalty.
      "repetition": 0.1

    }

  }

}
